{% extends '_layouts/base.twig' %}

{% block body %}
    {% set contactEntry = craft.entries.section('contact').one() %}

    <main class="min-h-screen bg-gradient-to-b from-blue-500 via-blue-100 to-slate-50">
        <section class="bg-cover bg-center px-4 py-10 shadow-md sm:px-6 lg:px-8" style="background-image: linear-gradient(rgba(15, 23, 42, 0.48), rgba(37, 99, 235, 0.56)), url('/assets/onedream-front-hero-no-cars.jpg'); background-position: center 58%;">
            <div class="mx-auto max-w-7xl">
                <div class="max-w-2xl py-8 lg:py-16">
                    <p class="text-sm font-black uppercase tracking-[0.25em] text-blue-100">Fast, Fresh & Delicious</p>
                    <h1 class="mt-3 text-4xl font-black tracking-tight text-white sm:text-5xl md:text-5xl">One Dream</h1>
                    <p class="mt-5 text-lg leading-6 text-blue-100">Food, fuel, and everyday essentials.</p>

                    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                        <a class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-black uppercase tracking-widest text-brand-blue-dark shadow-sm hover:bg-blue-50" href="tel:+15182505545">Call</a>
                        <a class="inline-flex items-center justify-center gap-2 rounded-md border border-white/40 bg-red-600 px-6 py-3 text-base font-black uppercase tracking-widest text-white shadow-sm hover:bg-red-700" href="http://qsapi.petrosoft.cloud/get/mobile" target="_blank" rel="noopener noreferrer">
                            <span class="inline-flex gap-1.5 pr-1">
                                <svg class="size-5 shrink-0 p-0.5" aria-hidden="true" viewBox="0 0 24 24" fill="#fff">
                                    <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
                                </svg>
                                <svg class="size-5 shrink-0 p-0.5" aria-hidden="true" viewBox="0 0 24 24" fill="#fff">
                                    <path d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z" />
                                </svg>
                            </span>
                            Download the App
                        </a>
                        <a class="inline-flex items-center justify-center gap-2 rounded-md border border-white/40 bg-red-600 px-6 py-3 text-base font-black uppercase tracking-widest text-white shadow-sm hover:bg-red-700" href="https://www.doordash.com/store/33145957?utm_source=mx_share&amp;aw=4pZcsrkYVOF7oE_x" target="_blank" rel="noopener noreferrer">
                            <svg class="size-5 shrink-0 p-0.5" aria-hidden="true" viewBox="0 0 24 24" fill="#fff">
                                <path d="M23.071 8.409a6.09 6.09 0 0 0-5.396-3.228H.584A.589.589 0 0 0 .17 6.184L3.894 9.93a1.752 1.752 0 0 0 1.242.516h12.049a1.554 1.554 0 1 1 .031 3.108H8.91a.589.589 0 0 0-.415 1.003l3.725 3.747a1.75 1.75 0 0 0 1.242.516h3.757c4.887 0 8.584-5.225 5.852-10.413" />
                            </svg>
                            DoorDash
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            {% if entry.formattedText %}
                <div class="mb-16 rounded-lg bg-white p-8 shadow-sm ring-1 ring-slate-200">
                    <div class="prose max-w-none prose-headings:text-brand-blue-dark prose-p:text-ink-muted prose-a:text-brand-blue prose-a:hover:text-brand-blue-dark md:prose-lg">
                        {{ entry.formattedText }}
                    </div>
                </div>
            {% endif %}

            <div class="mb-16 grid gap-8 rounded-lg bg-white p-8 shadow-sm ring-1 ring-slate-200 lg:grid-cols-2 lg:items-start">
                <div>
                    {% if contactEntry and contactEntry.formattedText %}
                        <div class="prose max-w-none prose-headings:text-brand-blue-dark prose-p:text-ink-muted prose-a:text-brand-blue prose-a:hover:text-brand-blue-dark md:prose-lg">
                            {{ contactEntry.formattedText }}
                        </div>
                    {% endif %}

                    <div class="mt-8 space-y-4 text-sm font-semibold leading-6 text-ink">
                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 size-5 shrink-0 text-ink-soft" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 21s7-5.1 7-12A7 7 0 0 0 5 9c0 6.9 7 12 7 12Z" />
                                <circle cx="12" cy="9" r="2.5" />
                            </svg>
                            <p>
                                616 Columbia Street Ext.<br>
                                Latham, NY, United States, New York
                            </p>
                        </div>

                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 size-5 shrink-0 text-ink-soft" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
                            </svg>
                            <a class="font-semibold hover:underline" href="tel:+15182505545">(518) 250-5545</a>
                        </div>

                        <div class="flex items-start gap-3">
                            <svg class="mt-0.5 size-5 shrink-0 text-ink-soft" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect width="20" height="16" x="2" y="4" rx="2" />
                                <path d="m22 7-10 6L2 7" />
                            </svg>
                            <a class="font-semibold hover:underline" href="mailto:gtbfuel9corp@gmail.com">gtbfuel9corp@gmail.com</a>
                        </div>
                    </div>
                </div>

                <div class="overflow-hidden rounded-lg ring-1 ring-slate-200">
                    <iframe
                        class="h-72 w-full sm:h-80 lg:h-96"
                        src="https://www.google.com/maps?q=616%20Columbia%20Street%20Ext%2C%20Latham%2C%20NY&output=embed"
                        title="Map to One Dream"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                    ></iframe>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
