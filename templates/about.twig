{% extends '_layouts/base.twig' %}

{% block body %}
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <section class="prose prose-headings:text-brand-blue-dark prose-p:text-ink-muted prose-a:text-brand-blue prose-a:hover:text-brand-blue-dark mx-auto min-h-screen max-w-5xl rounded-lg bg-white p-8 shadow-sm ring-1 ring-slate-200">
            <header class="not-prose mb-8 text-center">
                <p class="text-sm font-semibold uppercase tracking-[0.25em] text-ink-soft">Fast, Fresh & Delicious</p>
                <h1 class="mt-2 text-4xl font-black tracking-tight sm:text-5xl">One Dream</h1>
                <p class="mt-3 text-sm text-ink-soft">Prices subject to change.</p>
            </header>

            {% if entry.formattedText %}
                {{ entry.formattedText }}
            {% endif %}
        </section>
    </main>
{% endblock %}
