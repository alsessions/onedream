{% extends '_layouts/base.twig' %}

{% block body %}
    <main class="min-h-screen bg-gradient-to-b from-blue-500 via-blue-100 to-slate-50">
        <section class="bg-cover bg-center px-4 py-10 shadow-md sm:px-6 lg:px-8" style="background-image: linear-gradient(rgba(37, 99, 235, 0.72), rgba(37, 99, 235, 0.72)), url('/assets/onedream-hero-optimized.jpg');">
            <div class="mx-auto max-w-7xl">
                <div class="max-w-2xl py-8 lg:py-16">
                    <p class="text-sm font-black uppercase tracking-[0.25em] text-white drop-shadow-md">Fast, Fresh & Delicious</p>
                    <h1 class="mt-3 text-4xl font-black tracking-tight text-white drop-shadow-md sm:text-5xl md:text-5xl">One Dream</h1>
                    <p class="mt-5 text-lg font-semibold leading-6 text-white drop-shadow-md">Fresh-made favorites, easy pickup, and the kind of food that makes a quick stop feel like a good decision.</p>

                    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                        <a class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-black uppercase tracking-widest text-brand-blue-dark shadow-sm hover:bg-blue-50" href="tel:+15182505545">Call</a>
                        <a class="inline-flex items-center justify-center rounded-md border border-white bg-red-600 px-6 py-3 text-base font-black uppercase tracking-widest text-white shadow-sm hover:bg-red-700" href="https://www.doordash.com/store/33145957?utm_source=mx_share&amp;aw=4pZcsrkYVOF7oE_x" target="_blank" rel="noopener noreferrer">Order Now</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            <div class="grid gap-5 pb-12 md:grid-cols-3">
                <article class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200">
                    <p class="text-sm font-black uppercase tracking-widest text-brand-blue-dark">Sunoco</p>
                    <h2 class="mt-3 font-sans text-2xl font-black text-ink">Sunoco gas, 24/7</h2>
                    <p class="mt-3 text-base leading-6 text-ink-muted">Fuel up any time, day or night, with reliable Sunoco gas ready whenever your schedule brings you through Latham.</p>
                </article>

                <article class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200">
                    <p class="text-sm font-black uppercase tracking-widest text-brand-blue-dark">Fast</p>
                    <h2 class="mt-3 font-sans text-2xl font-black text-ink">Fast, fresh food</h2>
                    <p class="mt-3 text-base leading-6 text-ink-muted">Grab fresh, satisfying food made for busy days, with convenient pickup and delivery options when you want something quick and dependable.</p>
                </article>

                <article class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200">
                    <p class="text-sm font-black uppercase tracking-widest text-brand-blue-dark">Local</p>
                    <h2 class="mt-3 font-sans text-2xl font-black text-ink">Right in Latham</h2>
                    <p class="mt-3 text-base leading-6 text-ink-muted">Find us at 616 Columbia Street Ext. for an easy stop close to home, work, and the road when you need food, fuel, or both.</p>
                </article>
            </div>

            <div class="grid gap-8 border-t border-blue-200 pt-12 pb-16 lg:grid-cols-2 lg:items-center">
                <div>
                    <p class="text-sm font-black uppercase tracking-widest text-brand-blue-dark">Convenience Store & Kitchen</p>
                    <h2 class="mt-3 font-sans text-3xl font-black text-ink sm:text-4xl">Food, fuel, and everyday essentials in Latham</h2>
                    <p class="mt-5 text-lg leading-8 text-ink-muted">One Dream Latham is a local convenience store offering food, drinks, snacks, everyday essentials, and more. The full kitchen serves mouthwatering favorites like flavorful butter chicken, hot cheesesteaks, and other freshly prepared options. Whether you are grabbing a quick meal, picking up a drink, or stocking up on necessities, One Dream Latham has you covered.</p>
                </div>

                <div class="overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-slate-200">
                    <iframe
                        class="aspect-video w-full border-0"
                        src="https://www.google.com/maps?q=One%20Dream%20Latham%20616%20Columbia%20Street%20Ext%20Latham%20NY&amp;output=embed"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="Map to One Dream Latham"
                    ></iframe>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
