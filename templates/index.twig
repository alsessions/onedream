{% extends '_layouts/base.twig' %}

{% block body %}
    <main class="min-h-screen bg-gradient-to-b from-blue-500 via-blue-100 to-slate-50">
        <section class="bg-cover bg-center px-4 py-10 shadow-md sm:px-6 lg:px-8" style="background-image: linear-gradient(rgba(15, 23, 42, 0.48), rgba(37, 99, 235, 0.56)), url('/assets/onedream-front-hero-no-cars.jpg'); background-position: center 58%;">
            <div class="mx-auto max-w-7xl">
                <div class="max-w-2xl py-8 lg:py-16">
                    <p class="text-sm font-black uppercase tracking-[0.25em] text-white drop-shadow-md">Fast, Fresh & Delicious</p>
                    <h1 class="mt-3 text-4xl font-black tracking-tight text-white drop-shadow-md sm:text-5xl md:text-5xl">One Dream</h1>
                    <p class="mt-5 text-lg font-semibold leading-6 text-white drop-shadow-md">Fresh-made favorites, easy pickup, and the kind of food that makes a quick stop feel like a good decision.</p>

                    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                        <a class="inline-flex items-center justify-center rounded-md bg-white px-6 py-3 text-base font-black uppercase tracking-widest text-brand-blue-dark shadow-sm hover:bg-blue-50" href="/menu">View Menu</a>
                        <a class="inline-flex items-center justify-center gap-2 rounded-md border border-white/40 bg-red-600 px-6 py-3 text-base font-black uppercase tracking-widest text-white shadow-sm hover:bg-red-700" href="http://qsapi.petrosoft.cloud/get/mobile" target="_blank" rel="noopener noreferrer">
                            <span class="inline-flex gap-1.5 pr-1">
                                <svg class="size-5 shrink-0 p-0.5" aria-hidden="true" viewBox="0 0 24 24" fill="#fff">
                                    <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701" />
                                </svg>
                                <svg class="size-5 shrink-0 p-0.5" aria-hidden="true" viewBox="0 0 24 24" fill="#fff">
                                    <path d="M18.4395 5.5586c-.675 1.1664-1.352 2.3318-2.0274 3.498-.0366-.0155-.0742-.0286-.1113-.043-1.8249-.6957-3.484-.8-4.42-.787-1.8551.0185-3.3544.4643-4.2597.8203-.084-.1494-1.7526-3.021-2.0215-3.4864a1.1451 1.1451 0 0 0-.1406-.1914c-.3312-.364-.9054-.4859-1.379-.203-.475.282-.7136.9361-.3886 1.5019 1.9466 3.3696-.0966-.2158 1.9473 3.3593.0172.031-.4946.2642-1.3926 1.0177C2.8987 12.176.452 14.772 0 18.9902h24c-.119-1.1108-.3686-2.099-.7461-3.0683-.7438-1.9118-1.8435-3.2928-2.7402-4.1836a12.1048 12.1048 0 0 0-2.1309-1.6875c.6594-1.122 1.312-2.2559 1.9649-3.3848.2077-.3615.1886-.7956-.0079-1.1191a1.1001 1.1001 0 0 0-.8515-.5332c-.5225-.0536-.9392.3128-1.0488.5449zm-.0391 8.461c.3944.5926.324 1.3306-.1563 1.6503-.4799.3197-1.188.0985-1.582-.4941-.3944-.5927-.324-1.3307.1563-1.6504.4727-.315 1.1812-.1086 1.582.4941zM7.207 13.5273c.4803.3197.5506 1.0577.1563 1.6504-.394.5926-1.1038.8138-1.584.4941-.48-.3197-.5503-1.0577-.1563-1.6504.4008-.6021 1.1087-.8106 1.584-.4941z" />
                                </svg>
                            </span>
                            Download the App
                        </a>
                        <a class="inline-flex items-center justify-center gap-2 rounded-md border border-white/40 bg-red-600 px-6 py-3 text-base font-black uppercase tracking-widest text-white shadow-sm hover:bg-red-700" href="https://www.doordash.com/store/33145957?utm_source=mx_share&amp;aw=4pZcsrkYVOF7oE_x" target="_blank" rel="noopener noreferrer">
                            <svg class="size-5 shrink-0 p-0.5" aria-hidden="true" viewBox="0 0 24 24" fill="#fff">
                                <path d="M23.071 8.409a6.09 6.09 0 0 0-5.396-3.228H.584A.589.589 0 0 0 .17 6.184L3.894 9.93a1.752 1.752 0 0 0 1.242.516h12.049a1.554 1.554 0 1 1 .031 3.108H8.91a.589.589 0 0 0-.415 1.003l3.725 3.747a1.75 1.75 0 0 0 1.242.516h3.757c4.887 0 8.584-5.225 5.852-10.413" />
                            </svg>
                            DoorDash
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
            <div class="grid gap-5 pb-12 md:grid-cols-3">
                <article class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200">
                    <p class="text-sm font-black uppercase tracking-widest text-brand-blue-dark">Mobil</p>
                    <h2 class="mt-3 font-sans text-2xl font-black text-ink">Mobil gas, 24/7</h2>
                    <p class="mt-3 text-base leading-6 text-ink-muted">Fuel up any time, day or night, with reliable Mobil gas ready whenever your schedule brings you through Latham.</p>
                </article>

                <article class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200">
                    <p class="text-sm font-black uppercase tracking-widest text-brand-blue-dark">Fast</p>
                    <h2 class="mt-3 font-sans text-2xl font-black text-ink">Fast, fresh food</h2>
                    <p class="mt-3 text-base leading-6 text-ink-muted">Grab fresh, satisfying food made for busy days, with convenient pickup and delivery options when you want something quick and dependable.</p>
                </article>

                <article class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200">
                    <p class="text-sm font-black uppercase tracking-widest text-brand-blue-dark">Local</p>
                    <h2 class="mt-3 font-sans text-2xl font-black text-ink">Right in Latham</h2>
                    <p class="mt-3 text-base leading-6 text-ink-muted">Find us at 616 Columbia Street Ext. for an easy stop close to home, work, and the road when you need food, fuel, or both.</p>
                </article>
            </div>

            <div class="grid gap-8 border-t border-blue-200 pt-12 pb-16 lg:grid-cols-2 lg:items-center">
                <div>
                    <p class="text-sm font-black uppercase tracking-widest text-brand-blue-dark">Convenience Store & Kitchen</p>
                    <h2 class="mt-3 font-sans text-3xl font-black text-ink sm:text-4xl">Food, fuel, and everyday essentials in Latham</h2>
                    <p class="mt-5 text-lg leading-8 text-ink-muted">One Dream Latham is a local convenience store in Latham offering food, drinks, snacks, everyday essentials, and more.</p> <p class="mt-5 text-lg leading-8 text-ink-muted"> Our full kitchen serves up mouthwatering favorites like flavorful butter chicken, hot cheesesteaks, and other freshly prepared options. Whether you’re grabbing a quick meal, picking up a drink, or stocking up on necessities, One Dream Latham has you covered.</p>
                </div>

                <div class="overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-slate-200">
                    <iframe
                        class="aspect-video w-full border-0"
                        src="https://www.google.com/maps?q=One%20Dream%20Latham%20616%20Columbia%20Street%20Ext%20Latham%20NY&amp;output=embed"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="Map to One Dream Latham"
                    ></iframe>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
